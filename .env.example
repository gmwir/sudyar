# Copy this file to ".env" and fill in the values. NEVER share or commit ".env".

# --- Required ---
DIGIKALA_SELF_TOKEN=
POSTGRES_PASSWORD=

# --- Database (defaults are fine for docker compose) ---
POSTGRES_USER=sudyar
POSTGRES_DB=sudyar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Digikala API (verified from the official Swagger) ---
# Auth is always "Authorization: Bearer <Self Token>" (set in code).
DIGIKALA_BASE_URL=https://seller.digikala.com
DIGIKALA_VARIANTS_PATH=/open-api/v1/variants
DIGIKALA_PAGE_PARAM=page
DIGIKALA_PAGE_SIZE_PARAM=size
# Swagger default is 50. The largest size Digikala accepts is not known yet:
# try a bigger number at the first real run and set it here.
DIGIKALA_PAGE_SIZE=50
DIGIKALA_ITEMS_KEY=data.items
# Money values are stored exactly as returned. Unit (Rial or Toman) is NOT verified yet.
DIGIKALA_FIELD_MAP={"digikala_variant_id":"id","product_id":"product_id","product_variant_id":"product_variant_id","title":"title","product_title":"product_title","active":"active","is_archived":"is_archived","price_sale":"price_sale","cash_selling_price":"cash_selling_price","price_limit":"price_limit","marketplace_seller_stock":"marketplace_seller_stock","warehouse_stock":"warehouse_stock","buy_box_price":"buy_box_price","is_buy_box_winner":"is_buy_box_winner","is_seller_buy_box_winner":"is_seller_buy_box_winner","is_in_buy_box_challenge":"is_in_buy_box_challenge","is_sku_winner":"is_sku_winner","rating":"rating","lead_time":"lead_time"}

# --- Rate limits (all optional) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_PERIOD_SECONDS=30
MAX_CONCURRENT=3
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_SECONDS=60
BREAKER_THRESHOLD=3
BREAKER_PAUSE_SECONDS=300

# --- Radar (Part 2) ---
# Tier intervals in seconds: HOT = in challenge / lost Buy Box in last hour / manual override
RADAR_HOT_INTERVAL_SECONDS=120
RADAR_WARM_INTERVAL_SECONDS=600
RADAR_CALM_INTERVAL_SECONDS=3600
RADAR_HOT_LOST_WINDOW_SECONDS=3600
RADAR_WARM_EVENT_WINDOW_SECONDS=86400
# Share of the read limit (RATE_LIMIT_REQUESTS per period) the radar may use
RADAR_BUDGET_FRACTION=0.6
WINNING_PRICE_CACHE_SECONDS=600
# UNVERIFIED optional server-side filter params for the variants list (JSON). Not used by default.
# DIGIKALA_VARIANTS_EXTRA_PARAMS={}

# --- Notifications ---
# DRY-RUN by default: messages are only printed. Set to true to really send.
NOTIFY_ENABLED=false
NOTIFY_CHANNELS=telegram
# Which events send an alert (all events are always stored)
NOTIFY_EVENT_TYPES=BUYBOX_LOST,BUYBOX_REGAINED,ENTERED_CHALLENGE,STOCK_OUT,DEACTIVATED
# At most one alert per variant in this many seconds (1800 = 30 min)
NOTIFY_COOLDOWN_SECONDS=1800
# Quiet hours, local time HH:MM (leave empty for none). Alerts in this window are skipped, not delayed.
NOTIFY_QUIET_START=
NOTIFY_QUIET_END=
NOTIFY_TIMEZONE=Asia/Tehran
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BALE_BOT_TOKEN=
BALE_CHAT_ID=
# UNVERIFIED: Bale Bot API base URL (same shape as Telegram). Confirm in Bale's docs before use.
BALE_API_BASE=
