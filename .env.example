# Copy this file to ".env" and fill in the values. NEVER share or commit ".env".

# --- Required ---
DIGIKALA_SELF_TOKEN=
POSTGRES_PASSWORD=

# --- Database (defaults are fine for docker compose) ---
POSTGRES_USER=sudyar
POSTGRES_DB=sudyar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Digikala API (verified from the official Swagger) ---
# Auth is always "Authorization: Bearer <Self Token>" (set in code).
DIGIKALA_BASE_URL=https://seller.digikala.com
DIGIKALA_VARIANTS_PATH=/open-api/v1/variants
DIGIKALA_PAGE_PARAM=page
DIGIKALA_PAGE_SIZE_PARAM=size
# Swagger default is 50. The largest size Digikala accepts is not known yet:
# try a bigger number at the first real run and set it here.
DIGIKALA_PAGE_SIZE=50
DIGIKALA_ITEMS_KEY=data.items
# Money values are stored exactly as returned. Unit (Rial or Toman) is NOT verified yet.
DIGIKALA_FIELD_MAP={"digikala_variant_id":"id","product_id":"product_id","product_variant_id":"product_variant_id","title":"title","product_title":"product_title","active":"active","is_archived":"is_archived","price_sale":"price_sale","cash_selling_price":"cash_selling_price","price_limit":"price_limit","marketplace_seller_stock":"marketplace_seller_stock","warehouse_stock":"warehouse_stock","buy_box_price":"buy_box_price","is_buy_box_winner":"is_buy_box_winner","is_seller_buy_box_winner":"is_seller_buy_box_winner","is_in_buy_box_challenge":"is_in_buy_box_challenge","is_sku_winner":"is_sku_winner","rating":"rating","lead_time":"lead_time"}

# --- Rate limits (all optional) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_PERIOD_SECONDS=30
MAX_CONCURRENT=3
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_SECONDS=60
BREAKER_THRESHOLD=3
BREAKER_PAUSE_SECONDS=300

# --- Radar (Part 2) ---
# Tier intervals in seconds: HOT = in challenge / lost Buy Box in last hour / manual override
RADAR_HOT_INTERVAL_SECONDS=120
RADAR_WARM_INTERVAL_SECONDS=600
RADAR_CALM_INTERVAL_SECONDS=3600
RADAR_HOT_LOST_WINDOW_SECONDS=3600
RADAR_WARM_EVENT_WINDOW_SECONDS=86400
# Share of the read limit (RATE_LIMIT_REQUESTS per period) the radar may use
RADAR_BUDGET_FRACTION=0.6
WINNING_PRICE_CACHE_SECONDS=600
# UNVERIFIED optional server-side filter params for the variants list (JSON). Not used by default.
# DIGIKALA_VARIANTS_EXTRA_PARAMS={}

# --- Notifications ---
# DRY-RUN by default: messages are only printed. Set to true to really send.
NOTIFY_ENABLED=false
NOTIFY_CHANNELS=telegram
# Which events send an alert (all events are always stored)
NOTIFY_EVENT_TYPES=BUYBOX_LOST,BUYBOX_REGAINED,ENTERED_CHALLENGE,STOCK_OUT,DEACTIVATED
# At most one alert per variant in this many seconds (1800 = 30 min)
NOTIFY_COOLDOWN_SECONDS=1800
# Quiet hours, local time HH:MM (default 23:00-07:00; the web page can change them). Alerts in this window are skipped, not delayed.
NOTIFY_QUIET_START=23:00
NOTIFY_QUIET_END=07:00
NOTIFY_TIMEZONE=Asia/Tehran
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BALE_BOT_TOKEN=
BALE_CHAT_ID=
# UNVERIFIED: Bale Bot API base URL (same shape as Telegram). Confirm in Bale's docs before use.
BALE_API_BASE=

# --- Profit floor (Parts 3 / 3b) ---
# Per the official Swagger: Digikala prices and winning-price suggested_price are in RIAL.
# Floor math converts to Toman (Rial / 10) and Persian messages show Toman. Use "toman" only if you
# ever find the API returns Toman.
DIGIKALA_PRICE_UNIT=rial
DIGIKALA_SUGGESTED_PRICE_UNIT=rial
# Fees: GET /open-api/v1/commissions/ (token scope "commission"). Run: sync-fees (re-read at most every 24 h).
FEES_COMMISSIONS_PATH=/open-api/v1/commissions/
# UNVERIFIED meaning of search[my_commissions]; only sent when true.
FEES_ONLY_MY_COMMISSIONS=false
# Optional search[main_category_id]
FEES_MAIN_CATEGORY_ID=
FEES_CACHE_SECONDS=86400
# UNCONFIRMED meaning in the Swagger. Default: the floor uses `commission` only.
FLOOR_INCLUDE_EXTRA_COMMISSION=false
FLOOR_INCLUDE_RETURN_FREE_COMMISSION=false
# Sales: GET /open-api/v1/insight/sales-reports (token scope "insight"). Run: sales-sync --range last_30_days
SALES_REPORTS_PATH=/open-api/v1/insight/sales-reports
SALES_CACHE_SECONDS=86400
SALES_MAX_PAGES=50
# Orders (READ-ONLY): GET /open-api/v1/orders/history, token scope "order". Run: orders-sync --days 3
# UNVERIFIED assumptions (no real response seen): unit_price is Rial and BEFORE unit_discount.
ORDERS_PATH=/open-api/v1/orders/history
ORDERS_CACHE_SECONDS=21600
ORDERS_MAX_PAGES=50
ORDERS_DEFAULT_DAYS=3
ORDERS_PRICE_UNIT=rial
ORDERS_DISCOUNT_MODE=subtract
# Variant list items carry category_id and supplier_code (used as SKU). They have NO brand field.
FLOOR_CATEGORY_FIELD=category_id
COST_SKU_FIELD=supplier_code
# Fulfillment, tax, ad share, return reserve and packaging have NO Digikala endpoint: set them yourself
# with the set-floor command (see README_FA.md). Unset = not included, and reports say so.

# --- Safety nets (Part 3c) ---
# Refuse a commissions sync that has more than this % fewer rows than the last good one (sync-fees --force overrides)
FEES_MAX_DROP_PCT=30
# If commissions are older than this many days (refresh keeps failing), floors show needs_fees
FEES_MAX_STALE_DAYS=3
# Only these hosts may receive Bale alerts (UNVERIFIED default; check Bale's docs)
BALE_ALLOWED_HOSTS=tapi.bale.ai
# Set to 1 to log error details (secrets are always redacted)
# SUDYAR_DEBUG=1

# --- Web page (Part 4a) ---
# Optional password for the web page. The page listens on this computer only (127.0.0.1:8080).
# It is REQUIRED if you ever run `python -m sudyar web --host 0.0.0.0` (reachable from other computers).
WEB_PASSWORD=
# Optional: fixed key for the login cookie (otherwise random at every start; you just log in again).
# WEB_SECRET_KEY=
# On a server behind HTTPS (later): make the login cookie HTTPS-only.
# WEB_HTTPS_ONLY_COOKIE=1
# On a server behind a reverse proxy (later): the proxy's own IP(s), comma-separated, so the
# wrong-password limit counts each visitor separately. Leave empty on your own computer.
# WEB_TRUSTED_PROXIES=

# --- Server (Part 5a; ONLY on the server, filled by deploy/install.sh) ---
# Your web address and an email for the free HTTPS certificate.
# SUDYAR_DOMAIN=app.sudyarapp.ir
# ACME_EMAIL=
# Server mode (SUDYAR_SERVER=1, WEB_HTTPS_ONLY_COOKIE=1, WEB_TRUSTED_PROXIES) is set by
# deploy/docker-compose.server.yml, not here. Server mode refuses to start without
# WEB_PASSWORD (12+ characters) and WEB_SECRET_KEY (32+ characters).

# --- Service Hub OAuth (Part 5b; after Digikala approves the app) ---
# With a client code and NO DIGIKALA_SELF_TOKEN, Sudyar reads through the seller's own consent
# (web page > Settings > Connect to Digikala). Leave empty to keep using the Self Token.
# SERVICEHUB_CLIENT_CODE=
# Default on a server: https://<SUDYAR_DOMAIN>/oauth/callback (must match the registered redirect_url)
# SERVICEHUB_REDIRECT_URL=
# Private key file made by: python -m sudyar oauth-keygen (it also prints the public key to register)
# SERVICEHUB_PRIVATE_KEY_FILE=/data/secrets/servicehub_private_key.pem
# Read-only scopes only; write-capable scopes are refused.
# SERVICEHUB_SCOPES=variant.read order.read commission insight
# Encrypts the stored tokens. oauth-keygen prints one; deploy/install.sh sets it on the server.
# SUDYAR_TOKEN_KEY=
