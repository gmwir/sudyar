# Copy this file to ".env" and fill in the values. NEVER share or commit ".env".

# --- Required ---
DIGIKALA_SELF_TOKEN=
POSTGRES_PASSWORD=

# --- Database (defaults are fine for docker compose) ---
POSTGRES_USER=sudyar
POSTGRES_DB=sudyar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Digikala API (TODO: confirm every value below in the official Swagger) ---
DIGIKALA_BASE_URL=https://seller.digikala.com/open-api/v1
# TODO: exact "list variants" path from Swagger (example shape: /variants). Required.
DIGIKALA_VARIANTS_PATH=
# TODO: how the Self Token is sent. Header name and optional prefix.
DIGIKALA_AUTH_HEADER=Authorization
DIGIKALA_AUTH_PREFIX=
# TODO: pagination parameter names and page size
DIGIKALA_PAGE_PARAM=page
DIGIKALA_PAGE_SIZE_PARAM=size
DIGIKALA_PAGE_SIZE=50
# TODO: JSON path of the list inside the response, and field names of each variant
DIGIKALA_ITEMS_KEY=items
DIGIKALA_FIELD_MAP={"variant_id":"id","product_id":"product_id","title":"title","price":"price","stock":"stock","active":"is_active"}

# --- Rate limits (all optional) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_PERIOD_SECONDS=30
MAX_CONCURRENT=3
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_SECONDS=60
BREAKER_THRESHOLD=3
BREAKER_PAUSE_SECONDS=300
