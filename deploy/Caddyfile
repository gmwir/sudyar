# Sudyar on a server: automatic HTTPS (Let's Encrypt / ZeroSSL) in front of the web UI.
# SUDYAR_DOMAIN and ACME_EMAIL come from .env (set by deploy/install.sh).
{
	email {$ACME_EMAIL}
	admin off
}

{$SUDYAR_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 3MB
	}
	reverse_proxy web:8080
}
